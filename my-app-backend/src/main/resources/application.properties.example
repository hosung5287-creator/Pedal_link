spring.application.name=my-app-backend

# DB명은 Pedal_link (testbike 아님) — 자전거도로 데이터(cycleways)가 이 DB에 있음
# 클론 후 이 파일을 application.properties로 복사하고 비밀번호를 본인 환경에 맞게 수정
spring.datasource.url=jdbc:postgresql://localhost:5432/Pedal_link
spring.datasource.username=postgres
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Gemini API (프로필 AI 기능) — 키는 my-app-backend/.env 의 GEMINI_API_KEY 또는 같은 이름의 환경변수로 넣는다.
# 이 파일에 직접 적지 말 것. 없으면 AI 기능만 꺼지고 나머지는 그대로 동작한다. 모델은 GEMINI_MODEL(비우면 gemini-3.8-flash).
spring.config.import=optional:file:./.env[.properties]
gemini.api-key=${GEMINI_API_KEY:}
gemini.model=${GEMINI_MODEL:}
gemini.base-url=${GEMINI_BASE_URL:}

# 시연 모드 — 가상 라이더 3명(민수·지영·현우)으로 크루 라이딩을 보여준다. 시연할 때만 .env 에 DEMO_ENABLED=true.
# 꺼져 있으면(기본) 시연 API·스케줄러가 만들어지지 않는다(/api/demo/status 만 enabled:false 로 답함). 배포 서버에는 켜지 말 것.
demo.enabled=${DEMO_ENABLED:false}
# 시연 패널을 띄울 발표자 계정 (콤마로 여러 개). 비우면 가상 라이더가 아닌 모든 계정에 뜬다.
demo.presenter-emails=${DEMO_PRESENTER_EMAILS:}
